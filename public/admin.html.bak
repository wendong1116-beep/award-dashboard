<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>数据管理后台</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet">
    <script src="js/particles.js"></script>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        :root{
            --gold:#c9a227;
            --gold-light:#e8d48b;
            --gold-dark:#8b7020;
            --bg-dark:#0a0a0f;
            --bg-card:#12121a;
            --border-gold:rgba(201,162,39,0.3);
            --text-dim:rgba(255,255,255,0.45);
            --text-light:rgba(255,255,255,0.85)
        }
        body{
            font-family:'Noto Serif SC','Playfair Display',serif;
            background:var(--bg-dark);
            color:#fff;
            min-height:100vh
        }

        .header{
            position:fixed;top:0;left:0;right:0;z-index:100;
            padding:20px 40px;display:flex;justify-content:space-between;align-items:center;
            background:linear-gradient(to bottom,rgba(10,10,15,0.98),transparent);
            border-bottom:1px solid var(--border-gold)
        }
        .header h1{
            font-size:20px;color:var(--gold);font-weight:600;letter-spacing:4px
        }
        .btn{
            padding:10px 24px;border-radius:25px;border:1px solid var(--border-gold);
            background:transparent;color:var(--text-light);font-size:13px;cursor:pointer;
            font-family:inherit;transition:all 0.3s
        }
        .btn:hover{background:var(--gold);color:var(--bg-dark);border-color:var(--gold)}
        .btn-primary{background:var(--gold);color:var(--bg-dark);border-color:var(--gold)}
        .btn-primary:hover{background:var(--gold-light);border-color:var(--gold-light)}

        .main{max-width:1400px;margin:0 auto;padding:100px 40px 60px}

        .page-title{
            text-align:center;margin-bottom:50px
        }
        .page-title h2{
            font-size:36px;font-weight:400;color:var(--gold);letter-spacing:8px;margin-bottom:12px
        }
        .page-title .divider{
            width:80px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:0 auto
        }

        .stats-grid{
            display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:50px
        }
        .stat-card{
            background:var(--bg-card);border:1px solid var(--border-gold);
            border-radius:20px;padding:36px;text-align:center;
            transition:all 0.3s
        }
        .stat-card:hover{border-color:var(--gold);transform:translateY(-4px)}
        .stat-card .icon{font-size:32px;margin-bottom:12px}
        .stat-card .value{
            font-size:42px;font-weight:600;color:var(--gold);margin-bottom:8px
        }
        .stat-card .label{font-size:14px;color:var(--text-dim);letter-spacing:2px}

        .section{
            background:var(--bg-card);border:1px solid var(--border-gold);
            border-radius:20px;padding:32px;margin-bottom:30px
        }
        .section-header{
            display:flex;justify-content:space-between;align-items:center;
            margin-bottom:24px;padding-bottom:20px;
            border-bottom:1px solid rgba(255,255,255,0.05)
        }
        .section-title{
            font-size:18px;color:var(--gold);letter-spacing:3px;font-weight:400
        }

        .form-row{
            display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-bottom:24px
        }
        .form-group{margin-bottom:0}
        .form-group label{
            display:block;margin-bottom:8px;font-size:13px;color:var(--text-dim);letter-spacing:1px
        }
        .form-group input,.form-group select{
            width:100%;padding:12px 16px;border-radius:12px;
            border:1px solid rgba(255,255,255,0.1);
            background:rgba(255,255,255,0.03);color:#fff;font-size:14px;
            font-family:inherit
        }
        .form-group input:focus,.form-group select:focus{
            outline:none;border-color:var(--gold)
        }
        .form-group select option{background:var(--bg-card)}

        .upload-area{
            border:2px dashed var(--border-gold);border-radius:16px;
            padding:50px;text-align:center;cursor:pointer;transition:all 0.3s
        }
        .upload-area:hover{border-color:var(--gold);background:rgba(201,162,39,0.05)}
        .upload-area input{display:none}
        .upload-icon{font-size:40px;margin-bottom:16px;opacity:0.6}
        .upload-text{color:var(--text-dim);font-size:14px}
        .upload-hint{color:rgba(255,255,255,0.3);font-size:12px;margin-top:8px}

        .upload-status{margin-top:16px;font-size:14px}
        .upload-status.success{color:#4ade80}
        .upload-status.error{color:#f87171}

        .table-wrapper{overflow-x:auto;border-radius:12px;border:1px solid rgba(255,255,255,0.05)}
        table{width:100%;border-collapse:collapse}
        th,td{
            padding:16px 20px;text-align:left;border-bottom:1px solid rgba(255,255,255,0.04);
            white-space:nowrap;font-size:14px
        }
        th{
            color:var(--text-dim);font-weight:400;font-size:13px;letter-spacing:1px;
            background:rgba(255,255,255,0.02)
        }
        td{color:var(--text-light)}
        tr:hover td{background:rgba(201,162,39,0.04)}
        tr:last-child td{border-bottom:none}

        .action-btn{
            padding:6px 14px;border-radius:8px;border:1px solid var(--border-gold);
            background:transparent;color:var(--text-dim);font-size:12px;cursor:pointer;
            font-family:inherit;transition:all 0.3s;margin-right:8px
        }
        .action-btn:hover{background:rgba(201,162,39,0.1);color:var(--gold);border-color:var(--gold)}
        .action-btn.danger:hover{background:rgba(248,113,113,0.1);color:#f87171;border-color:#f87171}

        .pagination{display:flex;justify-content:center;gap:8px;margin-top:30px;flex-wrap:wrap}
        .pagination button{
            padding:8px 16px;border-radius:10px;border:1px solid var(--border-gold);
            background:transparent;color:var(--text-dim);font-size:13px;cursor:pointer;
            font-family:inherit;transition:all 0.3s
        }
        .pagination button:hover:not(:disabled){background:rgba(201,162,39,0.1);color:var(--gold)}
        .pagination button.active{background:var(--gold);color:var(--bg-dark);border-color:var(--gold)}
        .pagination button:disabled{opacity:0.3;cursor:not-allowed}

        .modal{
            position:fixed;inset:0;background:rgba(0,0,0,0.88);backdrop-filter:blur(15px);
            display:none;justify-content:center;align-items:center;z-index:1000;padding:20px
        }
        .modal.show{display:flex}
        .modal-content{
            background:var(--bg-card);border:1px solid var(--border-gold);
            border-radius:24px;padding:40px;width:100%;max-width:640px;max-height:85vh;overflow-y:auto
        }
        .modal-header{
            display:flex;justify-content:space-between;align-items:center;
            margin-bottom:30px;padding-bottom:20px;
            border-bottom:1px solid rgba(255,255,255,0.05)
        }
        .modal-header h3{font-size:18px;color:var(--gold);font-weight:400;letter-spacing:2px}
        .modal-close{
            width:36px;height:36px;border-radius:50%;border:1px solid var(--border-gold);
            background:transparent;color:var(--text-dim);cursor:pointer;font-size:18px;
            display:flex;align-items:center;justify-content:center;transition:all 0.3s
        }
        .modal-close:hover{background:rgba(248,113,113,0.1);color:#f87171;border-color:#f87171}
        .modal-footer{
            display:flex;justify-content:flex-end;gap:12px;margin-top:30px;
            padding-top:20px;border-top:1px solid rgba(255,255,255,0.05)
        }

        @media (max-width: 768px) {
            .header{flex-direction:column;gap:16px;padding:16px 20px}
            .main{padding:120px 20px 40px}
            .stats-grid{grid-template-columns:1fr}
            .form-row{grid-template-columns:1fr}
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>数据管理后台</h1>
        <button class="btn" onclick="logout()">退出登录</button>
    </div>

    <div class="main">
        <div class="page-title">
            <h2>ADMIN PANEL</h2>
            <div class="divider"></div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="icon">📊</div>
                <div class="value" id="totalCount">-</div>
                <div class="label">总记录数</div>
            </div>
            <div class="stat-card">
                <div class="icon">🏆</div>
                <div class="value" id="awardCount">-</div>
                <div class="label">奖项类别</div>
            </div>
            <div class="stat-card">
                <div class="icon">🎯</div>
                <div class="value" id="regionCount">-</div>
                <div class="label">获奖单位</div>
            </div>
        </div>

        <div class="section">
            <div class="section-header">
                <div class="section-title">数据导入</div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>奖项类别</label>
                    <select id="importAward"></select>
                </div>
                <div class="form-group">
                    <label>操作</label>
                    <div style="display:flex;gap:12px">
                        <button class="btn btn-primary" onclick="document.getElementById('fileInput').click()">选择文件</button>
                        <button class="btn" onclick="exportData()">导出Excel</button>
                    </div>
                </div>
            </div>
            <div class="upload-area" onclick="event.stopPropagation()">
                <input type="file" id="fileInput" accept=".xls,.xlsx" onchange="handleFile(this.files[0])">
                <div class="upload-icon">📁</div>
                <div class="upload-text">点击上方按钮选择Excel文件</div>
                <div class="upload-hint">支持 .xls 和 .xlsx 格式</div>
            </div>
            <div class="upload-status" id="uploadStatus"></div>
        </div>

        <div class="section">
            <div class="section-header">
                <div class="section-title">数据管理</div>
                <button class="btn btn-primary" onclick="showAddModal()">+ 新增记录</button>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>搜索产品</label>
                    <input type="text" id="adminSearch" placeholder="输入产品名称搜索..." oninput="loadProducts()">
                </div>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead id="tableHead"></thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
            <div class="pagination" id="pagination"></div>
        </div>
    </div>

    <div class="modal" id="editModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">新增记录</h3>
                <button class="modal-close" onclick="closeModal()">×</button>
            </div>
            <form id="editForm">
                <input type="hidden" id="editId">
                <div class="form-row">
                    <div class="form-group">
                        <label>奖项名称 *</label>
                        <select id="editName" required></select>
                    </div>
                    <div class="form-group">
                        <label>年份</label>
                        <input type="text" id="editYear" placeholder="如：2024年">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>获奖单位</label>
                        <input type="text" id="editRegion" placeholder="获奖单位">
                    </div>
                    <div class="form-group">
                        <label>产品名称 *</label>
                        <input type="text" id="editProductName" placeholder="产品名称" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>获奖等级</label>
                        <input type="text" id="editAwardLevel" placeholder="如：金奖、银奖">
                    </div>
                    <div class="form-group">
                        <label>摄影/产品类型</label>
                        <input type="text" id="editPhotographyType" placeholder="类型">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>装订方式</label>
                        <input type="text" id="editBinding" placeholder="装订方式">
                    </div>
                    <div class="form-group">
                        <label>出版社</label>
                        <input type="text" id="editPublisher" placeholder="出版社">
                    </div>
                </div>
                <div class="form-group">
                    <label>特点亮点</label>
                    <input type="text" id="editFeatures" placeholder="设计、工艺、技术等特点">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" onclick="closeModal()">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentPage = 1;
        const pageSize = 15;
        let currentAward = '';

        async function checkAuth() {
            const resp = await fetch('/api/auth/check');
            const data = await resp.json();
            if (!data.authenticated) window.location.href = 'login.html';
        }

        async function loadStats() {
            const resp = await fetch('/api/stats');
            const stats = await resp.json();
            document.getElementById('totalCount').textContent = stats.total || 0;
            document.getElementById('awardCount').textContent = stats.awardCount || 0;
            document.getElementById('regionCount').textContent = stats.regionCount || '-';
        }

        async function loadAwardOptions() {
            const resp = await fetch('/api/award-options');
            const awards = await resp.json();
            const html = awards.map(a => '<option value="' + a + '">' + a + '</option>').join('');
            document.getElementById('importAward').innerHTML = html;
            document.getElementById('editName').innerHTML = html;
            if (awards.length > 0) currentAward = awards[0];
        }

        async function loadProducts() {
            const search = document.getElementById('adminSearch').value;
            const resp = await fetch('/api/admin/products?page=' + currentPage + '&limit=' + pageSize + '&search=' + encodeURIComponent(search));
            const data = await resp.json();
            renderTable(data.items || []);
            renderPagination(data.totalPages || 1);
        }

        function renderTable(items) {
            document.getElementById('tableHead').innerHTML = '<tr><th>ID</th><th>奖项</th><th>产品名称</th><th>等级</th><th>单位</th><th>年份</th><th>操作</th></tr>';
            document.getElementById('tableBody').innerHTML = items.map(p =>
                '<tr>' +
                '<td style="color:var(--text-dim)">' + p.id + '</td>' +
                '<td style="color:var(--gold)">' + (p.name || '-') + '</td>' +
                '<td>' + (p.product_name || '-') + '</td>' +
                '<td>' + (p.award_level || '-') + '</td>' +
                '<td>' + (p.region || '-') + '</td>' +
                '<td style="color:var(--text-dim)">' + (p.year || '-') + '</td>' +
                '<td><button class="action-btn" onclick="editProduct(' + p.id + ')">编辑</button><button class="action-btn danger" onclick="deleteProduct(' + p.id + ')">删除</button></td>' +
                '</tr>'
            ).join('');
        }

        function renderPagination(totalPages) {
            if (totalPages <= 1) { document.getElementById('pagination').innerHTML = ''; return; }
            let html = '<button onclick="changePage(' + (currentPage - 1) + ')" ' + (currentPage === 1 ? 'disabled' : '') + '>上一页</button>';
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    html += '<button onclick="changePage(' + i + ')" class="' + (i === currentPage ? 'active' : '') + '">' + i + '</button>';
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    html += '<span style="color:#666">...</span>';
                }
            }
            html += '<button onclick="changePage(' + (currentPage + 1) + ')" ' + (currentPage === totalPages ? 'disabled' : '') + '>下一页</button>';
            document.getElementById('pagination').innerHTML = html;
        }

        function changePage(page) {
            currentPage = page;
            loadProducts();
            document.querySelector('.section').scrollIntoView({ behavior: 'smooth' });
        }

        async function handleFile(file) {
            if (!file) return;
            const award = document.getElementById('importAward').value;
            if (!award) { showStatus('请先选择奖项类别', 'error'); return; }

            const formData = new FormData();
            formData.append('file', file);
            formData.append('award', award);
            showStatus('正在导入...', '');

            try {
                const resp = await fetch('/api/upload', { method: 'POST', body: formData });
                const data = await resp.json();
                if (resp.ok) {
                    showStatus('成功导入 ' + data.imported + ' 条记录', 'success');
                    loadStats();
                    loadProducts();
                } else {
                    showStatus('导入失败: ' + data.error, 'error');
                }
            } catch (e) {
                showStatus('导入失败: ' + e.message, 'error');
            }
        }

        function showStatus(msg, type) {
            const el = document.getElementById('uploadStatus');
            el.textContent = msg;
            el.className = 'upload-status ' + type;
        }

        async function editProduct(id) {
            const resp = await fetch('/api/products/' + id);
            const p = await resp.json();
            document.getElementById('modalTitle').textContent = '编辑记录';
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = p.name || '';
            document.getElementById('editYear').value = p.year || '';
            document.getElementById('editRegion').value = p.region || '';
            document.getElementById('editProductName').value = p.product_name || '';
            document.getElementById('editAwardLevel').value = p.award_level || '';
            document.getElementById('editPhotographyType').value = p.photography_type || '';
            document.getElementById('editBinding').value = p.binding || '';
            document.getElementById('editPublisher').value = p.publisher || '';
            document.getElementById('editFeatures').value = p.features || '';
            document.getElementById('editModal').classList.add('show');
        }

        async function deleteProduct(id) {
            if (!confirm('确定要删除这条记录吗？')) return;
            const resp = await fetch('/api/admin/products/' + id, { method: 'DELETE' });
            if (resp.ok) loadProducts();
        }

        function showAddModal() {
            document.getElementById('modalTitle').textContent = '新增记录';
            document.getElementById('editId').value = '';
            document.getElementById('editForm').reset();
            if (currentAward) document.getElementById('editName').value = currentAward;
            document.getElementById('editModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('editModal').classList.remove('show');
        }

        document.getElementById('editForm').onsubmit = async (e) => {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const data = {
                name: document.getElementById('editName').value,
                year: document.getElementById('editYear').value,
                region: document.getElementById('editRegion').value,
                product_name: document.getElementById('editProductName').value,
                award_level: document.getElementById('editAwardLevel').value,
                photography_type: document.getElementById('editPhotographyType').value,
                binding: document.getElementById('editBinding').value,
                publisher: document.getElementById('editPublisher').value,
                features: document.getElementById('editFeatures').value
            };
            const url = id ? '/api/admin/products/' + id : '/api/admin/products';
            const method = id ? 'PUT' : 'POST';
            const resp = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            if (resp.ok) { closeModal(); loadProducts(); }
        };

        async function exportData() {
            const award = document.getElementById('importAward').value;
            if (!award) { alert('请先选择一个奖项类别'); return; }
            window.location.href = '/api/export/' + encodeURIComponent(award);
        }

        async function logout() {
            await fetch('/api/auth/logout', { method: 'POST' });
            window.location.href = 'login.html';
        }

        checkAuth();
        loadStats();
        loadAwardOptions();
        loadProducts();
    </script>
</body>
</html>